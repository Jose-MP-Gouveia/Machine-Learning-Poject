"      \u003ctd\u003e2795\u003c/td\u003e\n","    \u003c/tr\u003e\n","    \u003ctr\u003e\n","      \u003cth\u003eInvestor\u003c/th\u003e\n","      \u003ctd\u003e2778\u003c/td\u003e\n","    \u003c/tr\u003e\n","    \u003ctr\u003e\n","      \u003cth\u003eFitness Enthusiast\u003c/th\u003e\n","      \u003ctd\u003e2754\u003c/td\u003e\n","    \u003c/tr\u003e\n","  \u003c/tbody\u003e\n","\u003c/table\u003e\n","\u003c/div\u003e\u003cbr\u003e\u003clabel\u003e\u003cb\u003edtype:\u003c/b\u003e int64\u003c/label\u003e"],"text/plain":["lifestyle\n","Health-Conscious      2795\n","Investor              2778\n","Fitness Enthusiast    2754\n","Name: count, dtype: int64"]},"execution_count":12,"metadata":{},"output_type":"execute_result"}],"source":["#Checking the number of individuals for each lifestyle\n","y.value_counts()"]},{"cell_type":"markdown","metadata":{"id":"1u2nXvFPea7k"},"source":["#Performing the Cross Validation"]},{"cell_type":"markdown","metadata":{"id":"wezwQulxeiyf"},"source":["First, we define the function that will implement a K-Fold Stratified Cross-Validation. We will start with k = 10 and change it later if necessary, along with other parameters."]},{"cell_type":"code","execution_count":13,"metadata":{"executionInfo":{"elapsed":19,"status":"ok","timestamp":1749723792971,"user":{"displayName":"Tomás Pires","userId":"14399308892702349161"},"user_tz":-60},"id":"0cc5a544"},"outputs":[],"source":["def cv_scores(model, X, y):\n","\n","    #apply skfold\n","    skf = StratifiedKFold(n_splits=10, shuffle=True, random_state = 42)\n","\n","    #create lists to store the results from the different models\n","    acc_score_train = []\n","    acc_score_val = []\n","    precision_score_train = []\n","    precision_score_val = []\n","    recall_score_train = []\n","    recall_score_val = []\n","    f1_score_train = []\n","    f1_score_val = []\n","\n","    #start timer\n","    timer = []\n","\n","    for train_index, val_index in skf.split(X, y):\n","\n","        # get the indexes of the observations assigned for each partition\n","        X_train, X_val = X.iloc[train_index], X.iloc[val_index]\n","        y_train, y_val = y.iloc[train_index], y.iloc[val_index]\n","\n","        # start counting time\n","        begin = time.perf_counter()\n","\n","        ###Preprocessing###\n","\n","        #convert outliers for the variable age into missing values\n","        X_train.loc[X_train['age'] \u003e 68, 'age'] = np.nan\n","        X_train.loc[X_train['age'] \u003c 17, 'age'] = np.nan\n","        X_val.loc[X_val['age'] \u003e 68, 'age'] = np.nan\n","        X_val.loc[X_val['age'] \u003c 17, 'age'] = np.nan\n","\n","\n","        # Sync Indexes to assure that all observations from both sides match each other\n","        y_train = y_train.loc[X_train.index]\n","        y_val = y_val.loc[X_val.index]\n","\n","        ###imputation of missing values###\n","\n","\n","        # Drop categorical columns\n","        # Drop non-numeric columns and enforce float type\n","        X_train = X_train.select_dtypes(include=np.number).astype(float)\n","        X_val = X_val.select_dtypes(include=np.number).astype(float)\n","\n","\n","        # Impute missing values (numerical only)\n","        imputer = KNNImputer(n_neighbors=5)\n","        X_train_imputed = pd.DataFrame(imputer.fit_transform(X_train), columns=X_train.columns, index=X_train.index)\n","        X_val_imputed = pd.DataFrame(imputer.transform(X_val), columns=X_val.columns, index=X_val.index)\n","\n","        #Scaling\n","        feature_scaler = MinMaxScaler().fit(X_train_imputed)\n","\n","        #apply to training data\n","        X_train_scaled = pd.DataFrame(feature_scaler.transform(X_train_imputed), columns=X_train.columns, index=X_train.index)\n","\n","        #apply to val data\n","        X_val_scaled = pd.DataFrame(feature_scaler.transform(X_val_imputed), columns=X_val.columns, index=X_val.index)\n","\n","        # fit the model to the data\n","        model.fit(X_train_scaled, y_train)\n","\n","        # finish counting time\n","        end = time.perf_counter()\n","\n","        # predict for the train\n","        pred_train = model.predict(X_train_scaled)\n","\n","        # predict for val\n","        pred_val = model.predict(X_val_scaled)\n","\n","        #create variables for scores\n","        acc_train = accuracy_score(y_train, pred_train)\n","        acc_val = accuracy_score(y_val, pred_val)\n","        precision_train = precision_score(y_train, pred_train, average='macro')\n","        precision_val = precision_score(y_val, pred_val, average='macro')\n","        recall_train = recall_score(y_train, pred_train, average='macro')\n","        recall_val = recall_score(y_val, pred_val, average='macro')\n","        f1_train = f1_score(y_train, pred_train, average='macro')\n","        f1_val = f1_score(y_val, pred_val, average='macro')\n","\n","        #store the scores in the corresponding diffent lists\n","        acc_score_train.append(acc_train)\n","        acc_score_val.append(acc_val)\n","        precision_score_train.append(precision_train)\n","        precision_score_val.append(precision_val)\n","        recall_score_train.append(recall_train)\n","        recall_score_val.append(recall_val)\n","        f1_score_train.append(f1_train)\n","        f1_score_val.append(f1_val)\n","        timer.append(end-begin)\n","\n","    #store results in df\n","    model_results = pd.DataFrame(data = {\n","                                            'Train_Acc' :acc_score_train,\n","                                             'Val_acc': acc_score_val,\n","                                             'Train_Precision': precision_score_train,\n","                                             'Val_Precision' : precision_score_val,\n","                                             'Train_Recall' : recall_score_train,\n","                                             'Val_Recall' : recall_score_val,\n","                                             'Train_F1': f1_score_train,\n","                                             'Val_F1' : f1_score_val,\n","                                             'Time' : timer\n","                                            },\n","                                index = [f'Fold {i}' for i in range(1, 11)])\n","    #return results\n","    return model_results"]},{"cell_type":"markdown","metadata":{"id":"vdTOTYLLAEuw"},"source":["As just a bench mark we are going to use a logistic regression model.\n","The objective is to have a reference point to be surpassed by all other models, since the logistic regression will oversimplify the prediction.\n","We create two models, one with relations between 2 variables and the other relating 3 at once."]},{"cell_type":"code","execution_count":14,"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":331},"executionInfo":{"elapsed":24999,"status":"ok","timestamp":1749723817972,"user":{"displayName":"Tomás Pires","userId":"14399308892702349161"},"user_tz":-60},"id":"kv6InY-n-ikK","outputId":"65639953-9e4b-4a65-943b-2177f21217a8"},"outputs":[{"data":{"application/vnd.google.colaboratory.intrinsic+json":{"summary":"{\n  \"name\": \"avg_scores\",\n  \"rows\": 9,\n  \"fields\": [\n    {\n      \"column\": \"lr2model\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0.5062446994992019,\n        \"min\": 0.7375721864813639,\n        \"max\": 2.258938055099992,\n        \"num_unique_values\": 9,\n        \"samples\": [\n          0.7375721864813639,\n          0.7386771054575676,\n          0.7392657587435234\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}","type":"dataframe","variable_name":"avg_scores"},"text/html":["\n","  \u003cdiv id=\"df-a50c365d-a9be-45a5-8dc2-4b8597d435d9\" class=\"colab-df-container\"\u003e\n","    \u003cdiv\u003e\n","\u003cstyle scoped\u003e\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    