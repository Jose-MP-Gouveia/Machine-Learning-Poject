      #drop outliers for the variable age (Number?)\\n        X_train = X_train.drop(X_train[X_train['age'] < 17].index)\\n        X_train = X_train.drop(X_train[X_train['age'] > 100].index)\\n        X_val = X_val.drop(X_val[X_val['age'] < 17].index)\\n        X_val = X_val.drop(X_val[X_val['age'] > 100].index)\\n\\n        # Sync Indexes to assure that all observations from both sides match each other\\n        y_train = y_train.loc[X_train.index]\\n        y_val = y_val.loc[X_val.index]\\n\\n        ###imputation of missing values###\\n\\n        # Select only numerical columns and enforce float type\\n        X_train_numeric = X_train.select_dtypes(include=np.number).astype(float)\\n        X_val_numeric = X_val.select_dtypes(include=np.number).astype(float)\\n\\n        # Impute missing values (numerical only)\\n        imputer = KNNImputer(n_neighbors=5)\\n        X_train_imputed = pd.DataFrame(imputer.fit_transform(X_train_numeric), columns=X_train_numeric.columns, index=X_train_numeric.index)\\n        X_val_imputed = pd.DataFrame(imputer.transform(X_val_numeric), columns=X_val_numeric.columns, index=X_val_numeric.index)\\n\\n        #Scaling\\n        feature_scaler = MinMaxScaler().fit(X_train_imputed)\\n\\n        #apply to training data\\n        X_train_scaled = pd.DataFrame(feature_scaler.transform(X_train_imputed), columns=X_train_imputed.columns, index=X_train_imputed.index)\\n\\n        #apply to val data\\n        X_val_scaled = pd.DataFrame(feature_scaler.transform(X_val_imputed), columns=X_val_imputed.columns, index=X_val_imputed.index)\\n\\n        #Feature Selection as you see fit\\n        Intentionally left blank at this stage, but you are free to return here and see what changing this part\\n        does to the overall model performance\\n\\n        # fit the model to the data\\n        model.fit(X_train_scaled, y_train)\\n\\n        # finish counting time\\n        end = time.perf_counter()\\n\\n        # predict for the train\\n        pre